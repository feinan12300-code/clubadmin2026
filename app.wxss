/* app.wxss — 全局样式 */
page {
  background: #f5f6fa;
  color: #1f2937;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

/* 通用容器 */
.container {
  padding: 24rpx;
  box-sizing: border-box;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: #111827;
}

.card-title .sub {
  font-size: 24rpx;
  color: #9ca3af;
  font-weight: normal;
}

/* 按钮 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 28rpx;
  font-size: 26rpx;
  border-radius: 10rpx;
  background: #f3f4f6;
  color: #374151;
  border: none;
  line-height: 1;
}

.btn::after { border: none; }

.btn-primary { background: #6366f1; color: #fff; }
.btn-success { background: #10b981; color: #fff; }
.btn-danger  { background: #ef4444; color: #fff; }
.btn-warning { background: #f59e0b; color: #fff; }
.btn-sm { padding: 10rpx 18rpx; font-size: 22rpx; }
.btn-block { width: 100%; }
.btn[disabled] { opacity: 0.5; }

/* 标签 */
.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.6;
}
.tag-idle     { background: #d1fae5; color: #065f46; }
.tag-occupied { background: #fee2e2; color: #991b1b; }
.tag-reserved { background: #fef3c7; color: #92400e; }
.tag-pending  { background: #fef3c7; color: #92400e; }
.tag-seated   { background: #dbeafe; color: #1e40af; }
.tag-cancelled { background: #e5e7eb; color: #4b5563; }
.tag-noshow   { background: #fee2e2; color: #991b1b; }

/* 表单 */
.form-row { margin-bottom: 20rpx; }
.form-row label {
  display: block;
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 10rpx;
}
.form-row input,
.form-row textarea,
.form-row picker {
  width: 100%;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 10rpx;
  box-sizing: border-box;
}
.form-row textarea { height: 140rpx; }
.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 60rpx 20rpx;
  color: #9ca3af;
}
.empty-icon { font-size: 72rpx; margin-bottom: 16rpx; }

/* 列表项 */
.list-item {
  background: #fff;
  border-radius: 14rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}
.list-item .name { font-size: 30rpx; font-weight: 600; color: #111827; margin-bottom: 8rpx; }
.list-item .meta { font-size: 24rpx; color: #6b7280; margin-top: 6rpx; }
.list-item .actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
  border-top: 1rpx solid #f3f4f6;
  padding-top: 16rpx;
}

/* 统计卡片 */
.stat-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}
.stat-card {
  background: linear-gradient(135deg, #f9fafb, #f3f4f6);
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
}
.stat-value { font-size: 40rpx; font-weight: 700; color: #6366f1; }
.stat-label { font-size: 22rpx; color: #6b7280; margin-top: 6rpx; }

/* 顶部门店切换条 */
.venue-bar {
  background: #fff;
  padding: 18rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border-bottom: 1rpx solid #e5e7eb;
  position: sticky;
  top: 0;
  z-index: 10;
}
.venue-bar .label { font-size: 24rpx; color: #6b7280; }
.venue-bar picker { flex: 1; }
.venue-bar .picker-box {
  background: #f3f4f6;
  padding: 12rpx 20rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #111827;
}

/* 角色标签 */
.role-tag {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}
.role-tag.user { background: #d1fae5; color: #059669; }
.role-tag.admin { background: #ede9fe; color: #6366f1; }

/* 无权限提示 */
.no-permission {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  text-align: center;
}
.np-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.np-title { font-size: 32rpx; font-weight: 600; color: #1f2937; margin-bottom: 12rpx; }
.np-desc { font-size: 26rpx; color: #9ca3af; margin-bottom: 32rpx; }

/* 弹窗底部 */
.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border-top: 1rpx solid #e5e7eb;
}
.modal-footer > view {
  flex: 1;
  display: flex;
  gap: 16rpx;
}
.modal-footer .btn { flex: 1; }
