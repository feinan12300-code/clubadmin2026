/* app.wxss — 全局样式 */

/* ============ 设计系统变量 ============ */
page {
  /* 主色系 */
  --color-primary: #6366f1;
  --color-primary-soft: #818cf8;
  --color-primary-bg: #eef2ff;
  --color-success: #10b981;
  --color-success-bg: #d1fae5;
  --color-danger: #ef4444;
  --color-danger-bg: #fee2e2;
  --color-warning: #f59e0b;
  --color-warning-bg: #fef3c7;

  /* 中性色 */
  --color-text: #1f2937;
  --color-text-strong: #111827;
  --color-text-secondary: #6b7280;
  --color-text-muted: #9ca3af;

  /* 背景/容器 */
  --color-bg: #f3f4f6;
  --color-card: #ffffff;
  --color-border: #e5e7eb;
  --color-divider: #f3f4f6;
  --color-input-bg: #f9fafb;

  /* 阴影 */
  --shadow-card: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  --shadow-soft: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
  --shadow-primary: 0 6rpx 18rpx rgba(99, 102, 241, 0.22);

  /* 圆角 */
  --radius-card: 24rpx;
  --radius-cell: 16rpx;
  --radius-input: 16rpx;
  --radius-btn: 16rpx;
  --radius-tag: 8rpx;

  background: var(--color-bg);
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

/* ============ 通用容器 ============ */
.container {
  padding: 24rpx;
  box-sizing: border-box;
}

/* ============ 卡片 ============ */
.card {
  background: var(--color-card);
  border-radius: var(--radius-card);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--color-divider);
  box-sizing: border-box;
}

.card-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: var(--color-text-strong);
}

.card-title .sub {
  font-size: 24rpx;
  color: var(--color-text-muted);
  font-weight: normal;
}

/* ============ 按钮 ============ */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 30rpx;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: var(--radius-btn);
  background: var(--color-input-bg);
  color: #374151;
  border: none;
  line-height: 1;
  transition: opacity 0.15s ease, transform 0.12s ease;
}

.btn::after { border: none; }

.btn:active { transform: scale(0.97); opacity: 0.9; }

.btn-primary {
  background: linear-gradient(135deg, #6366f1, #818cf8);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(99, 102, 241, 0.28);
}
.btn-success {
  background: linear-gradient(135deg, #10b981, #34d399);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.25);
}
.btn-danger {
  background: linear-gradient(135deg, #ef4444, #f87171);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(239, 68, 68, 0.25);
}
.btn-warning {
  background: linear-gradient(135deg, #f59e0b, #fbbf24);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(245, 158, 11, 0.25);
}
.btn-sm { padding: 12rpx 20rpx; font-size: 22rpx; }
.btn-block { display: flex; width: 100%; }
.btn[disabled] { opacity: 0.5; box-shadow: none; }

/* ============ 标签 / Badge ============ */
.tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-tag);
  font-size: 22rpx;
  line-height: 1.6;
  font-weight: 500;
}
.tag-idle     { background: var(--color-success-bg); color: #065f46; }
.tag-occupied { background: var(--color-danger-bg); color: #991b1b; }
.tag-reserved { background: var(--color-warning-bg); color: #92400e; }
.tag-pending  { background: var(--color-warning-bg); color: #92400e; }
.tag-seated   { background: #dbeafe; color: #1e40af; }
.tag-cancelled { background: #e5e7eb; color: #4b5563; }
.tag-noshow   { background: var(--color-danger-bg); color: #991b1b; }

/* 徽标圆点样式（带圆点指示） */
.badge {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 12rpx;
  border-radius: var(--radius-tag);
  font-size: 22rpx;
  background: var(--color-input-bg);
  color: var(--color-text-secondary);
}
.badge .dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--color-success);
}
.badge.dot-idle .dot { background: var(--color-success); }
.badge.dot-busy .dot { background: var(--color-danger); }

/* ============ 表单 ============ */
.form-row { margin-bottom: 24rpx; }
.form-row label {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
  font-weight: 500;
}
.form-row input,
.form-row textarea,
.form-row picker,
.picker {
  width: 100%;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  background: var(--color-input-bg);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-input);
  box-sizing: border-box;
  color: var(--color-text-strong);
  transition: border-color 0.15s ease, background 0.15s ease;
}
.form-row input:focus,
.form-row textarea:focus {
  border-color: var(--color-primary);
  background: #fff;
}
.form-row textarea { height: 160rpx; }
.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

/* ============ 空状态 ============ */
.empty {
  text-align: center;
  padding: 80rpx 24rpx;
  color: var(--color-text-muted);
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.85;
}
.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 8rpx;
}
.empty-desc,
.empty-tip {
  font-size: 26rpx;
  color: var(--color-text-muted);
  margin-top: 8rpx;
}
.empty-tip { font-size: 24rpx; }

/* ============ 列表项 ============ */
.list-item {
  background: var(--color-card);
  border-radius: var(--radius-cell);
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-soft);
  border: 1rpx solid var(--color-divider);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.list-item:active {
  transform: scale(0.99);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.list-item .name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-strong);
  margin-bottom: 8rpx;
}
.list-item .meta {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
}
.list-item .actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
  border-top: 1rpx solid var(--color-divider);
  padding-top: 16rpx;
}

/* ============ 统计卡片 ============ */
.stat-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}
.stat-card {
  background: linear-gradient(135deg, #f9fafb, #f3f4f6);
  border-radius: var(--radius-cell);
  padding: 24rpx 20rpx;
  text-align: center;
  border: 1rpx solid var(--color-divider);
}
.stat-value {
  font-size: 42rpx;
  font-weight: 700;
  color: var(--color-primary);
  line-height: 1.2;
}
.stat-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 8rpx;
}

/* ============ 顶部门店切换条 ============ */
.venue-bar {
  background: #fff;
  padding: 18rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border-bottom: 1rpx solid var(--color-border);
  position: sticky;
  top: 0;
  z-index: 10;
}
.venue-bar .label { font-size: 24rpx; color: var(--color-text-secondary); }
.venue-bar picker { flex: 1; }
.venue-bar .picker-box {
  background: var(--color-bg);
  padding: 14rpx 22rpx;
  border-radius: var(--radius-input);
  font-size: 26rpx;
  color: var(--color-text-strong);
}

/* ============ 角色标签 ============ */
.role-tag {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-weight: 500;
}
.role-tag.user { background: var(--color-success-bg); color: #059669; }
.role-tag.admin { background: var(--color-primary-bg); color: var(--color-primary); }

/* ============ 头部操作区 ============ */
.header-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.cash-badge {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  background: #fef3c7;
  color: #92400e;
  font-weight: 500;
}

/* ============ 无权限提示 ============ */
.no-permission {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  text-align: center;
}
.np-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.np-title { font-size: 32rpx; font-weight: 600; color: var(--color-text); margin-bottom: 12rpx; }
.np-desc { font-size: 26rpx; color: var(--color-text-muted); margin-bottom: 32rpx; }

/* ============ 弹窗底部 ============ */
.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border-top: 1rpx solid var(--color-border);
}
.modal-footer > view {
  flex: 1;
  display: flex;
  gap: 16rpx;
}
.modal-footer .btn { flex: 1; }

/* ============ 价格 / 金额 ============ */
.price,
.amount {
  font-weight: 600;
  color: var(--color-danger);
}
.price-primary {
  font-weight: 600;
  color: var(--color-primary);
}

/* ============ 分割线 ============ */
.divider {
  height: 1rpx;
  background: var(--color-divider);
  margin: 20rpx 0;
}

/* ============ 通用页头 ============ */
.page-header {
  padding: 24rpx 0;
}
.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text-strong);
  margin-bottom: 6rpx;
}
.page-sub {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}
