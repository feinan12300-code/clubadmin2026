<view class="container">
  <view class="home-header">
    <view class="home-title">选择门店</view>
    <view class="logout-btn" bindtap="logout">退出</view>
  </view>

  <view wx:if="{{venues.length === 0}}" class="empty">
    <view class="empty-icon">🏠</view>
    <view class="empty-title">暂无门店</view>
    <view class="empty-tip">请管理员在管理端添加门店</view>
  </view>

  <view wx:else class="venue-grid">
    <view class="venue-card" wx:for="{{venues}}" wx:key="id" bindtap="enterVenue" data-id="{{item.id}}" hover-class="venue-card-hover">
      <view class="vc-head">
        <view class="vc-name">{{item.name}}</view>
        <view class="vc-arrow">›</view>
      </view>
      <view class="vc-meta">
        <text class="vc-icon">📍</text>
        <text class="vc-text">{{item.address || '-'}}</text>
      </view>
      <view class="vc-meta">
        <text class="vc-icon">🕐</text>
        <text class="vc-text">{{item.openHours || '-'}}</text>
      </view>
      <view class="vc-footer">
        <view class="vc-tags">
          <view class="vc-tag"><text class="vc-icon">🪑</text> {{item.tableCount}} 个桌台</view>
          <view class="vc-tag vc-queue"><text class="vc-icon">⏳</text> 排队 {{item.queueCount}} 桌</view>
        </view>
        <view class="vc-actions">
          <view class="vc-reserve" catchtap="goReservation" data-id="{{item.id}}">预定排队</view>
          <view class="vc-seats" catchtap="goVenueSeats" data-id="{{item.id}}">座位图</view>
          <view class="vc-enter">进入门店</view>
        </view>
      </view>
    </view>
  </view>
</view>
