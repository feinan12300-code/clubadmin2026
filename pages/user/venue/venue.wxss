.home-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0 28rpx;
}
.home-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #111827;
}
.role-btn {
  padding: 0 20rpx !important;
  font-size: 24rpx !important;
  line-height: 56rpx !important;
  border-radius: 28rpx !important;
}
.role-admin { background: #ede9fe !important; color: #6366f1 !important; }
.role-user { background: #d1fae5 !important; color: #059669 !important; }
.logout-btn {
  font-size: 24rpx;
  color: #9ca3af;
  padding: 10rpx 24rpx;
  background: #f3f4f6;
  border-radius: 999rpx;
}

.venue-grid {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.venue-card {
  background: #fff;
  border-radius: 22rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.05);
  border: 1rpx solid #f3f4f6;
  position: relative;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.venue-card-hover {
  transform: scale(0.98);
  box-shadow: 0 3rpx 10rpx rgba(99, 102, 241, 0.18);
}
.vc-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}
.vc-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
  flex: 1;
}
.vc-arrow {
  font-size: 44rpx;
  color: #6366f1;
  font-weight: 300;
  line-height: 1;
}
.vc-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 8rpx;
}
.vc-icon { font-size: 26rpx; }
.vc-text { flex: 1; }
.vc-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f3f4f6;
}
.vc-tag {
  font-size: 24rpx;
  color: #6b7280;
  background: #f9fafb;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
}
.vc-enter {
  font-size: 26rpx;
  color: #fff;
  background: linear-gradient(135deg, #4f46e5, #6366f1);
  font-weight: 500;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
}
.vc-admin-actions {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  display: flex;
  gap: 12rpx;
}
.add-fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #6366f1;
  color: #fff;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(99,102,241,0.4);
  z-index: 30;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 100rpx 20rpx;
  color: #9ca3af;
}
.empty-icon { font-size: 96rpx; margin-bottom: 20rpx; }
.empty-title { font-size: 32rpx; font-weight: 600; color: #1f2937; margin-bottom: 8rpx; }
.empty-tip { font-size: 24rpx; color: #9ca3af; }
