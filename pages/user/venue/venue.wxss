/* pages/user/venue/venue.wxss — 门店列表卡片优化 */

.home-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0 28rpx;
}
.home-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #111827;
}
.role-btn {
  padding: 0 20rpx !important;
  font-size: 24rpx !important;
  line-height: 56rpx !important;
  border-radius: 28rpx !important;
}
.role-admin { background: #ede9fe !important; color: #6366f1 !important; }
.role-user { background: #d1fae5 !important; color: #059669 !important; }
.logout-btn {
  font-size: 24rpx;
  color: #6b7280;
  padding: 10rpx 24rpx;
  background: #f3f4f6;
  border-radius: 999rpx;
  transition: opacity 0.15s ease, transform 0.12s ease;
}
.logout-btn:active { opacity: 0.8; transform: scale(0.97); }

.venue-grid {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 门店卡片：圆角 24rpx、柔和阴影、白底 */
.venue-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid #f3f4f6;
  position: relative;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.venue-card-hover {
  transform: scale(0.98);
  box-shadow: 0 6rpx 24rpx rgba(99, 102, 241, 0.22);
}

/* 动态台位统计条：紧贴卡片顶部、整行展示 */
.vc-stats {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 14rpx 18rpx;
  background: linear-gradient(135deg, #f5f7ff, #eef2ff);
  border-radius: 16rpx;
  margin-bottom: 18rpx;
  border: 1rpx solid #e0e7ff;
}
.vcs-item {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: #4b5563;
}
.vcs-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  display: inline-block;
}
.vcs-num {
  font-size: 26rpx;
  font-weight: 700;
  color: #111827;
  margin-left: 2rpx;
}
.vcs-label {
  font-size: 20rpx;
  color: #6b7280;
}
.vcs-idle .vcs-dot { background: #10b981; }
.vcs-occupied .vcs-dot { background: #ef4444; }
.vcs-reserved .vcs-dot { background: #f59e0b; }
.vcs-total {
  margin-left: auto;
  font-size: 22rpx;
  color: #6b7280;
  background: #fff;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  border: 1rpx solid #e5e7eb;
}

/* 已指派台位提示 */
.vc-bound {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #047857;
  background: #d1fae5;
  border: 1rpx solid #6ee7b7;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  margin-bottom: 14rpx;
}
.vcb-icon { font-size: 24rpx; }

/* 进入按钮禁用态：置灰，无阴影，不可点视觉 */
.vc-enter-disabled {
  background: #e5e7eb !important;
  color: #9ca3af !important;
  box-shadow: none !important;
}

.vc-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}
.vc-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #111827;
  flex: 1;
  line-height: 1.3;
}
.vc-arrow {
  font-size: 44rpx;
  color: #6366f1;
  font-weight: 300;
  line-height: 1;
  margin-left: 12rpx;
}

/* 地址 / 营业时间：带图标 */
.vc-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 26rpx;
  color: #6b7280;
  margin-top: 10rpx;
  line-height: 1.5;
}
.vc-icon { font-size: 26rpx; }
.vc-text { flex: 1; }

.vc-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f3f4f6;
  flex-wrap: wrap;
  gap: 16rpx;
}
.vc-tags {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}
/* 桌台/菜品数量：badge 样式 */
.vc-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: #6b7280;
  background: #f9fafb;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  border: 1rpx solid #f3f4f6;
}
.vc-tag.vc-queue {
  color: #b45309;
  background: #fef3c7;
  border-color: #fde68a;
}
.vc-actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
/* 预定排队入口：轻量描边按钮 */
.vc-reserve {
  display: inline-flex;
  align-items: center;
  font-size: 24rpx;
  color: #6366f1;
  background: #eef2ff;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid #c7d2fe;
  transition: opacity 0.15s ease, transform 0.12s ease;
}
.vc-reserve:active { opacity: 0.8; transform: scale(0.96); }
/* 座位图入口：轻量描边按钮 */
.vc-seats {
  display: inline-flex;
  align-items: center;
  font-size: 24rpx;
  color: #047857;
  background: #d1fae5;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid #6ee7b7;
  transition: opacity 0.15s ease, transform 0.12s ease;
}
.vc-seats:active { opacity: 0.8; transform: scale(0.96); }
/* 进入按钮：渐变背景，圆角，右侧箭头 */
.vc-enter {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 26rpx;
  color: #fff;
  background: linear-gradient(135deg, #6366f1, #818cf8);
  font-weight: 500;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 12rpx rgba(99, 102, 241, 0.28);
  transition: opacity 0.15s ease, transform 0.12s ease;
}
.vc-enter::after {
  content: '›';
  font-size: 32rpx;
  line-height: 1;
  margin-left: 2rpx;
}

.vc-admin-actions {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  display: flex;
  gap: 12rpx;
}
.add-fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6366f1, #818cf8);
  color: #fff;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(99, 102, 241, 0.4);
  z-index: 30;
  transition: transform 0.15s ease;
}
.add-fab:active { transform: scale(0.92); }

/* 空状态 */
.empty {
  text-align: center;
  padding: 100rpx 24rpx;
  color: #9ca3af;
}
.empty-icon { font-size: 80rpx; margin-bottom: 20rpx; opacity: 0.85; }
.empty-title { font-size: 32rpx; font-weight: 600; color: #1f2937; margin-bottom: 8rpx; }
.empty-tip { font-size: 26rpx; color: #9ca3af; }
