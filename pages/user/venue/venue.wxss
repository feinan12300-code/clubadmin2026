/* pages/user/venue/venue.wxss — 门店列表卡片优化 */

.home-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0 28rpx;
}
.home-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #111827;
}
.role-btn {
  padding: 0 20rpx !important;
  font-size: 24rpx !important;
  line-height: 56rpx !important;
  border-radius: 28rpx !important;
}
.role-admin { background: #ede9fe !important; color: #6366f1 !important; }
.role-user { background: #d1fae5 !important; color: #059669 !important; }
.logout-btn {
  font-size: 24rpx;
  color: #6b7280;
  padding: 10rpx 24rpx;
  background: #f3f4f6;
  border-radius: 999rpx;
  transition: opacity 0.15s ease, transform 0.12s ease;
}
.logout-btn:active { opacity: 0.8; transform: scale(0.97); }

.venue-grid {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 门店卡片：圆角 24rpx、柔和阴影、白底 */
.venue-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid #f3f4f6;
  position: relative;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.venue-card-hover {
  transform: scale(0.98);
  box-shadow: 0 6rpx 24rpx rgba(99, 102, 241, 0.22);
}

.vc-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}
.vc-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #111827;
  flex: 1;
  line-height: 1.3;
}
.vc-arrow {
  font-size: 44rpx;
  color: #6366f1;
  font-weight: 300;
  line-height: 1;
  margin-left: 12rpx;
}

/* 地址 / 营业时间：带图标 */
.vc-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 26rpx;
  color: #6b7280;
  margin-top: 10rpx;
  line-height: 1.5;
}
.vc-icon { font-size: 26rpx; }
.vc-text { flex: 1; }

.vc-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f3f4f6;
}
/* 桌台/菜品数量：badge 样式 */
.vc-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: #6b7280;
  background: #f9fafb;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  border: 1rpx solid #f3f4f6;
}
/* 进入按钮：渐变背景，圆角，右侧箭头 */
.vc-enter {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 26rpx;
  color: #fff;
  background: linear-gradient(135deg, #6366f1, #818cf8);
  font-weight: 500;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 12rpx rgba(99, 102, 241, 0.28);
  transition: opacity 0.15s ease, transform 0.12s ease;
}
.vc-enter::after {
  content: '›';
  font-size: 32rpx;
  line-height: 1;
  margin-left: 2rpx;
}

.vc-admin-actions {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  display: flex;
  gap: 12rpx;
}
.add-fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6366f1, #818cf8);
  color: #fff;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(99, 102, 241, 0.4);
  z-index: 30;
  transition: transform 0.15s ease;
}
.add-fab:active { transform: scale(0.92); }

/* 空状态 */
.empty {
  text-align: center;
  padding: 100rpx 24rpx;
  color: #9ca3af;
}
.empty-icon { font-size: 80rpx; margin-bottom: 20rpx; opacity: 0.85; }
.empty-title { font-size: 32rpx; font-weight: 600; color: #1f2937; margin-bottom: 8rpx; }
.empty-tip { font-size: 26rpx; color: #9ca3af; }
