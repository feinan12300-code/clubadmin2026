.order-list { display: flex; flex-direction: column; gap: 16rpx; }
.order-item {
  background: #f9fafb;
  border-radius: 12rpx;
  padding: 20rpx;
}
.order-head {
  display: flex;
  align-items: center;
  position: relative;
}
.order-left { flex: 1; }
.order-no { font-size: 28rpx; font-weight: 600; color: #1f2937; }
.order-meta { font-size: 22rpx; color: #9ca3af; margin-top: 4rpx; }
.order-right { text-align: right; margin-right: 32rpx; }
.order-total { font-size: 30rpx; font-weight: 700; color: #ef4444; }
.expand-arrow {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  font-size: 20rpx;
  color: #9ca3af;
}
.order-detail {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #e5e7eb;
}
.order-goods {
  display: flex;
  align-items: center;
  padding: 6rpx 0;
  font-size: 26rpx;
}
.g-name { flex: 1; color: #374151; }
.g-qty { width: 80rpx; text-align: center; color: #6b7280; }
.g-price { width: 120rpx; text-align: right; color: #1f2937; }
.order-notes {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #9ca3af;
}
