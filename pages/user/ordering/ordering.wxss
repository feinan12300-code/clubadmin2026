/* pages/user/ordering/ordering.wxss — 左右分栏 + 底部弹窗点单 */

page {
  background: #f5f6fa;
  height: 100vh;
  box-sizing: border-box;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

/* ========= 顶部桌台 banner ========= */
.table-banner {
  flex: 0 0 auto;
  background: linear-gradient(135deg, #6366f1, #818cf8);
  color: #fff;
  padding: 26rpx 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(99, 102, 241, 0.22);
  position: relative;
  overflow: hidden;
}
.table-banner::after {
  content: '';
  position: absolute;
  right: -40rpx;
  top: -40rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}
.tb-main { position: relative; }
.tb-label {
  font-size: 22rpx;
  opacity: 0.9;
  margin-bottom: 6rpx;
}
.tb-name {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
  line-height: 1.2;
  letter-spacing: 1rpx;
}
.tb-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  flex-wrap: wrap;
}
.tb-tag {
  background: rgba(255, 255, 255, 0.25);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}
.tb-cap { opacity: 0.9; }
.tb-status {
  background: rgba(255, 255, 255, 0.25);
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}
/* 桌台状态颜色（在 banner 上以浅色徽章呈现） */
.status-idle { background: rgba(16, 185, 129, 0.35); border-color: rgba(16, 185, 129, 0.5); }
.status-occupied { background: rgba(239, 68, 68, 0.35); border-color: rgba(239, 68, 68, 0.5); }
.status-reserved { background: rgba(245, 158, 11, 0.35); border-color: rgba(245, 158, 11, 0.5); }

/* ========= 中间：左右分栏 ========= */
.body {
  flex: 1;
  display: flex;
  overflow: hidden;
  min-height: 0;
}

/* 左侧：分类列表（约 160rpx 宽） */
.cat-list {
  width: 160rpx;
  flex: 0 0 160rpx;
  background: #f3f4f6;
  height: 100%;
}
.cat-item {
  padding: 28rpx 16rpx;
  font-size: 26rpx;
  color: #6b7280;
  text-align: center;
  border-left: 4rpx solid transparent;
  background: #f3f4f6;
  line-height: 1.3;
  transition: background 0.15s ease, color 0.15s ease;
}
.cat-item.active {
  background: #fff;
  color: #6366f1;
  font-weight: 600;
  border-left-color: #6366f1;
}
.cat-empty {
  padding: 40rpx 12rpx;
  text-align: center;
  color: #9ca3af;
  font-size: 22rpx;
}

/* 右侧：菜品列表 */
.dish-list {
  flex: 1;
  height: 100%;
  background: #fff;
  padding: 12rpx 18rpx;
  box-sizing: border-box;
}
.dish-empty {
  text-align: center;
  padding: 100rpx 20rpx;
  color: #9ca3af;
  font-size: 24rpx;
}
.de-icon { font-size: 80rpx; margin-bottom: 20rpx; opacity: 0.6; }

/* 菜品卡片 */
.dish-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 18rpx;
  margin-bottom: 14rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid #f3f4f6;
  transition: transform 0.12s ease, box-shadow 0.12s ease;
}
.dish-card:active {
  transform: scale(0.99);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.06);
}
.dish-card.disabled { opacity: 0.5; }
.dc-info { flex: 1; min-width: 0; }
.dc-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #111827;
  margin-bottom: 8rpx;
  line-height: 1.3;
}
.dc-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.dc-price {
  font-size: 30rpx;
  color: #ef4444;
  font-weight: 600;
}
.dc-stock {
  font-size: 22rpx;
  color: #9ca3af;
}
/* 加号按钮：圆形主色 */
.dc-add {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6366f1, #818cf8);
  color: #fff;
  font-size: 36rpx;
  line-height: 56rpx;
  text-align: center;
  flex: 0 0 56rpx;
  box-shadow: 0 4rpx 10rpx rgba(99, 102, 241, 0.35);
  transition: transform 0.12s ease, box-shadow 0.12s ease;
}
.dc-add:active {
  transform: scale(0.9);
  box-shadow: 0 2rpx 6rpx rgba(99, 102, 241, 0.3);
}
.dc-add.disabled {
  background: #d1d5db;
  box-shadow: none;
}

/* ========= 底部固定栏 ========= */
.bar {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  background: #fff;
  padding: 16rpx 24rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  border-top: 1rpx solid #f3f4f6;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}
.bar-left {
  flex: 1;
  min-width: 0;
}
.bar-total {
  display: flex;
  align-items: baseline;
  color: #ef4444;
  line-height: 1.1;
}
.bt-cur {
  font-size: 24rpx;
  font-weight: 600;
  margin-right: 2rpx;
}
.bt-num {
  font-size: 44rpx;
  font-weight: 700;
}
.bar-count {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 4rpx;
}
.bar-go {
  background: linear-gradient(135deg, #6366f1, #818cf8);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 44rpx;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 12rpx rgba(99, 102, 241, 0.35);
  transition: transform 0.12s ease;
}
.bar-go:active { transform: scale(0.96); }

/* ========= 订单明细弹窗 ========= */
.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 50;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  max-height: 75vh;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  display: flex;
  flex-direction: column;
  animation: sheetUp 0.25s ease;
  padding-bottom: env(safe-area-inset-bottom);
}
@keyframes sheetUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
.sheet-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx 16rpx;
  border-bottom: 1rpx solid #f3f4f6;
}
.sh-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
}
.sh-close {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  color: #9ca3af;
  font-size: 36rpx;
}
.sheet-list {
  flex: 1;
  padding: 8rpx 28rpx;
  max-height: 50vh;
}
.sheet-empty {
  text-align: center;
  padding: 80rpx 20rpx;
  color: #9ca3af;
  font-size: 24rpx;
}
.sl-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
  gap: 12rpx;
}
.sl-info { flex: 1; min-width: 0; }
.sl-name {
  font-size: 26rpx;
  color: #111827;
  margin-bottom: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.sl-price {
  font-size: 22rpx;
  color: #6b7280;
}
.sl-ctrl {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.sl-btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background: #f3f4f6;
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #374151;
}
.sl-btn:active { background: #e5e7eb; transform: scale(0.92); }
.sl-plus {
  background: #eef2ff;
  color: #6366f1;
}
.sl-qty {
  min-width: 36rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
}
.sheet-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  border-top: 2rpx solid #f3f4f6;
}
.sf-total {
  font-size: 26rpx;
  color: #6b7280;
}
.sf-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #ef4444;
  margin-left: 8rpx;
}
.sf-go {
  background: linear-gradient(135deg, #6366f1, #818cf8);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 16rpx 44rpx;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 12rpx rgba(99, 102, 241, 0.35);
}
.sf-go:active { transform: scale(0.96); }
