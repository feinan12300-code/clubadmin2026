/* pages/user/ordering/ordering.wxss — 左右分栏 + 底部弹窗点单 */

page {
  background: #f5f6fa;
  height: 100vh;
  box-sizing: border-box;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

/* 返回按钮栏 */
.back-bar {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #e5e7eb;
  position: relative;
  flex-shrink: 0;
}
.back-btn {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #6366f1;
  font-weight: 500;
  padding: 8rpx 4rpx 8rpx 0;
  transition: opacity 0.12s ease;
}
.back-btn:active { opacity: 0.6; }
.back-title {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
  pointer-events: none;
}

/* ========= 未绑定空状态 ========= */
.no-binding {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
}
.nb-icon { font-size: 120rpx; margin-bottom: 24rpx; opacity: 0.8; }
.nb-title { font-size: 34rpx; font-weight: 600; color: #1f2937; margin-bottom: 8rpx; }
.nb-sub { font-size: 26rpx; color: #9ca3af; margin-bottom: 40rpx; }
.nb-btn {
  background: linear-gradient(135deg, #6366f1, #818cf8);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 22rpx 56rpx;
  border-radius: 999rpx;
  box-shadow: 0 6rpx 18rpx rgba(99, 102, 241, 0.35);
}
.nb-btn:active { transform: scale(0.96); }

/* ========= 顶部桌台 banner ========= */
.table-banner {
  flex: 0 0 auto;
  background: linear-gradient(135deg, #6366f1, #818cf8);
  color: #fff;
  padding: 28rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4rpx 16rpx rgba(99, 102, 241, 0.22);
  position: relative;
  overflow: hidden;
}
.table-banner::after {
  content: '';
  position: absolute;
  right: -60rpx;
  top: -60rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}
.tb-left { position: relative; flex: 1; min-width: 0; }
.tb-label {
  font-size: 22rpx;
  opacity: 0.85;
  margin-bottom: 6rpx;
}
.tb-name {
  font-size: 42rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
  line-height: 1.2;
  letter-spacing: 1rpx;
}
.tb-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  flex-wrap: wrap;
}
.tb-tag {
  background: rgba(255, 255, 255, 0.25);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}
.tb-cap { opacity: 0.9; }
.tb-status {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 500;
}
.status-idle { background: rgba(16, 185, 129, 0.35); }
.status-occupied { background: rgba(239, 68, 68, 0.4); }
.status-reserved { background: rgba(245, 158, 11, 0.35); }
.tb-icon {
  font-size: 56rpx;
  position: relative;
  opacity: 0.9;
}

/* ========= 中间：左右分栏 ========= */
.body {
  flex: 1;
  display: flex;
  overflow: hidden;
  min-height: 0;
}

/* 左侧：分类列表 */
.cat-list {
  width: 168rpx;
  flex: 0 0 168rpx;
  background: #f0f1f5;
  height: 100%;
}
.cat-item {
  display: flex;
  align-items: center;
  padding: 26rpx 12rpx;
  font-size: 26rpx;
  color: #6b7280;
  background: transparent;
  line-height: 1.3;
  transition: all 0.18s ease;
  position: relative;
}
.ci-bar {
  width: 6rpx;
  height: 36rpx;
  border-radius: 4rpx;
  background: transparent;
  margin-right: 12rpx;
  flex: 0 0 6rpx;
  transition: background 0.18s ease;
}
.ci-text {
  flex: 1;
  word-break: break-all;
}
.cat-item.active {
  background: #fff;
  color: #6366f1;
  font-weight: 600;
}
.cat-item.active .ci-bar {
  background: linear-gradient(180deg, #6366f1, #818cf8);
}
.cat-empty {
  padding: 40rpx 12rpx;
  text-align: center;
  color: #9ca3af;
  font-size: 22rpx;
}

/* 右侧：菜品列表 */
.dish-list {
  flex: 1;
  height: 100%;
  background: #fff;
  padding: 12rpx 20rpx;
  box-sizing: border-box;
}
.dish-empty {
  text-align: center;
  padding: 100rpx 20rpx;
  color: #9ca3af;
  font-size: 24rpx;
}
.de-icon { font-size: 80rpx; margin-bottom: 16rpx; opacity: 0.5; }
.de-text { font-size: 26rpx; }

/* 菜品卡片 */
.dish-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 22rpx 18rpx;
  margin-bottom: 14rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid #f3f4f6;
  transition: transform 0.12s ease;
  gap: 16rpx;
}
.dish-card:active { transform: scale(0.98); }
.dish-card.disabled { opacity: 0.45; }

.dc-emoji {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #f0f1f5, #e8e9ee);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex: 0 0 80rpx;
}

.dc-info { flex: 1; min-width: 0; }
.dc-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 8rpx;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.dc-meta {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.dc-price {
  font-size: 32rpx;
  color: #ef4444;
  font-weight: 700;
}
.dc-stock {
  font-size: 20rpx;
  color: #9ca3af;
  background: #f3f4f6;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}
.dc-nostock { color: #ef4444; background: #fef2f2; }

/* 加号按钮 + 数量角标 */
.dc-add-wrap {
  position: relative;
  flex: 0 0 auto;
}
.dc-add {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6366f1, #818cf8);
  color: #fff;
  font-size: 36rpx;
  line-height: 56rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(99, 102, 241, 0.35);
  transition: transform 0.12s ease;
}
.dc-add:active { transform: scale(0.88); }
.dc-add.disabled {
  background: #d1d5db;
  box-shadow: none;
}
.dc-qty {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  background: #ef4444;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  border-radius: 999rpx;
  border: 3rpx solid #fff;
  box-sizing: content-box;
}

/* ========= 底部固定栏 ========= */
.bar {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  background: #fff;
  padding: 12rpx 24rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  border-top: 1rpx solid #f3f4f6;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  gap: 16rpx;
}

/* 购物车图标 */
.bar-cart {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6366f1, #818cf8);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 88rpx;
  box-shadow: 0 4rpx 16rpx rgba(99, 102, 241, 0.3);
}
.bar-cart:active { transform: scale(0.94); }
.bc-icon { font-size: 40rpx; }
.bc-badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  background: #ef4444;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  border-radius: 999rpx;
  border: 3rpx solid #fff;
  box-sizing: content-box;
}

.bar-left { flex: 1; min-width: 0; }
.bar-total {
  display: flex;
  align-items: baseline;
  color: #ef4444;
  line-height: 1.1;
}
.bt-cur {
  font-size: 24rpx;
  font-weight: 600;
  margin-right: 2rpx;
}
.bt-num {
  font-size: 44rpx;
  font-weight: 700;
}
.bar-count {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 4rpx;
}

.bar-go {
  background: linear-gradient(135deg, #6366f1, #818cf8);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 22rpx 44rpx;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 14rpx rgba(99, 102, 241, 0.35);
  transition: transform 0.12s ease;
  flex: 0 0 auto;
}
.bar-go:active { transform: scale(0.96); }
.bar-go.disabled {
  background: #d1d5db;
  box-shadow: none;
  color: #9ca3af;
}

/* ========= 订单明细弹窗 ========= */
.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 50;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  max-height: 75vh;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  display: flex;
  flex-direction: column;
  animation: sheetUp 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  padding-bottom: env(safe-area-inset-bottom);
}
@keyframes sheetUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
.sheet-handle {
  width: 64rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #e5e7eb;
  margin: 16rpx auto 0;
}
.sheet-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 28rpx 16rpx;
  border-bottom: 1rpx solid #f3f4f6;
}
.sh-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}
.sh-close {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  color: #9ca3af;
  font-size: 28rpx;
  background: #f3f4f6;
  border-radius: 50%;
}
.sh-close:active { background: #e5e7eb; }
.sheet-list {
  flex: 1;
  padding: 8rpx 28rpx;
  max-height: 50vh;
}
.sheet-empty {
  text-align: center;
  padding: 80rpx 20rpx;
  color: #9ca3af;
  font-size: 24rpx;
}
.se-icon { font-size: 80rpx; margin-bottom: 16rpx; opacity: 0.5; }
.sl-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
  gap: 16rpx;
}
.sl-info { flex: 1; min-width: 0; }
.sl-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #111827;
  margin-bottom: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.sl-price {
  font-size: 24rpx;
  color: #6b7280;
}
.sl-ctrl {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.sl-btn {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  background: #f3f4f6;
  border-radius: 50%;
  font-size: 32rpx;
  color: #374151;
  font-weight: 500;
}
.sl-btn:active { background: #e5e7eb; transform: scale(0.92); }
.sl-plus {
  background: #eef2ff;
  color: #6366f1;
}
.sl-qty {
  min-width: 40rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}
.sheet-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  border-top: 2rpx solid #f3f4f6;
}
.sf-total {
  font-size: 26rpx;
  color: #6b7280;
}
.sf-num {
  font-size: 38rpx;
  font-weight: 700;
  color: #ef4444;
  margin-left: 8rpx;
}
.sf-go {
  background: linear-gradient(135deg, #6366f1, #818cf8);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 48rpx;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 14rpx rgba(99, 102, 241, 0.35);
}
.sf-go:active { transform: scale(0.96); }
