<view class="container">
  <view class="card">
    <view class="card-title">
      <text>{{venueName || '预订排位'}}</text>
      <button class="btn btn-primary btn-sm" bindtap="openAdd">+ 新建预订</button>
    </view>
    <view class="form-row">
      <label>预订日期</label>
      <picker mode="date" value="{{date}}" bindchange="onDateChange">
        <view class="picker">{{date}}</view>
      </picker>
    </view>
  </view>

  <view class="card">
    <view class="card-title">
      <text>当日预订（{{reservations.length}} 条）</text>
    </view>
    <view wx:if="{{reservations.length === 0}}" class="empty">
      <view class="empty-icon">📅</view>
      <view>当日暂无预订</view>
    </view>
    <view wx:else>
      <view class="res-item" wx:for="{{reservations}}" wx:key="id">
        <view class="res-head">
          <text class="res-time">{{item.time}}</text>
          <text class="tag tag-{{item.status}}">{{item.statusLabel}}</text>
        </view>
        <view class="res-info">
          <text class="res-name">{{item.customerName}}</text>
          <text class="res-meta">{{item.partySize}} 人</text>
          <text class="res-meta">微信：{{item.wechat || '-'}}</text>
          <text wx:if="{{item.phone}}" class="res-meta">{{item.phone}}</text>
        </view>
        <view class="res-table">
          桌台：<text wx:if="{{item.tableName}}" class="res-tbl">{{item.tableName}}</text>
          <text wx:else class="res-unset">未指派</text>
        </view>
        <view wx:if="{{item.notes}}" class="res-notes">备注：{{item.notes}}</view>
        <view class="actions">
          <button wx:if="{{item.status === 'pending' && isAdmin}}" class="btn btn-sm btn-primary" bindtap="onSeat" data-id="{{item.id}}">到店入座</button>
          <button wx:if="{{item.status === 'pending' && isAdmin}}" class="btn btn-sm" bindtap="openEdit" data-id="{{item.id}}">改派</button>
          <button wx:if="{{item.status === 'pending'}}" class="btn btn-sm btn-danger" bindtap="onCancel" data-id="{{item.id}}">取消</button>
          <button wx:if="{{item.status === 'seated' && isAdmin}}" class="btn btn-sm btn-danger" bindtap="onNohow" data-id="{{item.id}}">标记未到</button>
        </view>
      </view>
    </view>
  </view>
</view>

<!-- 新建/编辑弹窗：分区卡片式表单 -->
<modal show="{{formShow}}" title="{{formId ? '编辑预订 / 改派' : '新建预订'}}" bind:close="closeForm">
  <view class="rform">
    <!-- 客户信息 -->
    <view class="rform-section">
      <view class="rform-section-title">
        <text class="rs-icon">👤</text>
        <text>客户信息</text>
      </view>
      <view class="rform-card">
        <view class="rform-field">
          <view class="rf-label">贵姓<text class="rf-req">*</text></view>
          <input class="rf-input" value="{{form.customerName}}" data-key="customerName" bindinput="onInput" placeholder="请填写您的贵姓" placeholder-class="rf-ph" />
        </view>
        <view class="rform-field">
          <view class="rf-label">微信<text class="rf-req">*</text></view>
          <input class="rf-input" value="{{form.wechat}}" data-key="wechat" bindinput="onInput" placeholder="微信号，便于联系" placeholder-class="rf-ph" />
        </view>
        <view class="rform-field">
          <view class="rf-label">电话<text class="rf-opt">选填</text></view>
          <input class="rf-input" type="number" value="{{form.phone}}" data-key="phone" bindinput="onInput" placeholder="手机号码" placeholder-class="rf-ph" />
        </view>
      </view>
    </view>

    <!-- 预订信息 -->
    <view class="rform-section">
      <view class="rform-section-title">
        <text class="rs-icon">📅</text>
        <text>预订信息</text>
      </view>
      <view class="rform-card">
        <view class="rform-field rf-row">
          <view class="rf-label">日期<text class="rf-req">*</text></view>
          <picker mode="date" value="{{form.date}}" bindchange="onFormDate">
            <view class="rf-picker">{{form.date}}<text class="rf-arrow">▾</text></view>
          </picker>
        </view>
        <view class="rform-field rf-row">
          <view class="rf-label">时间<text class="rf-req">*</text></view>
          <picker mode="time" value="{{form.time}}" bindchange="onFormTime">
            <view class="rf-picker">{{form.time}}<text class="rf-arrow">▾</text></view>
          </picker>
        </view>
        <view class="rform-field rf-row">
          <view class="rf-label">人数<text class="rf-req">*</text></view>
          <view class="stepper">
            <view class="step-btn {{form.partySize <= 1 ? 'step-disabled' : ''}}" bindtap="onDec">−</view>
            <view class="step-val">{{form.partySize}}</view>
            <view class="step-btn" bindtap="onInc">+</view>
            <view class="step-unit">人</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 备注 -->
    <view class="rform-section">
      <view class="rform-section-title">
        <text class="rs-icon">📝</text>
        <text>备注</text>
      </view>
      <view class="rform-card">
        <view class="rform-field">
          <textarea class="rf-textarea" value="{{form.notes}}" data-key="notes" bindinput="onInput" placeholder="如有特殊需求请填写" placeholder-class="rf-ph" />
        </view>
      </view>
    </view>

    <!-- 提示：台位由门店指派 -->
    <view class="rform-tip">台位由门店工作人员确认后指派，请耐心等待</view>
  </view>

  <view slot="footer">
    <button class="btn" bindtap="closeForm">取消</button>
    <button class="btn btn-primary" bindtap="onSave">{{formId ? '保存' : '创建预订'}}</button>
  </view>
</modal>
