/* pages/user/reservation/reservation.wxss — 预订页面 + 表单优化 */

/* 日期选择器样式（统一） */
.picker {
  padding: 20rpx 24rpx;
  background: #f9fafb;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #111827;
  box-sizing: border-box;
  transition: border-color 0.15s ease;
}

/* 预订卡片：圆角，状态色标签 */
.res-item {
  padding: 26rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}
.res-item:last-child { border-bottom: none; }
.res-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.res-time {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  line-height: 1.3;
}
.res-info {
  display: flex;
  gap: 24rpx;
  font-size: 26rpx;
  color: #374151;
  margin-bottom: 8rpx;
  flex-wrap: wrap;
}
.res-name { font-weight: 500; color: #111827; }
.res-meta { color: #6b7280; }
.res-table {
  font-size: 26rpx;
  color: #4b5563;
  margin-bottom: 8rpx;
}
.res-tbl {
  color: #6366f1;
  font-weight: 500;
}
.res-unset {
  color: #ef4444;
  background: #fee2e2;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}
.res-notes {
  font-size: 24rpx;
  color: #f59e0b;
  background: #fef3c7;
  padding: 8rpx 14rpx;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
  margin-top: 4rpx;
  line-height: 1.5;
}
.res-item .actions {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
  flex-wrap: wrap;
}

/* ============ 重构后的表单样式 ============ */
.rform {
  padding: 8rpx 0 16rpx;
}

/* 区块（客户信息 / 预订信息 / 桌台安排 / 备注） */
.rform-section {
  margin-bottom: 28rpx;
}
.rform-section:last-child { margin-bottom: 0; }

.rform-section-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #4b5563;
  margin-bottom: 14rpx;
  padding-left: 4rpx;
}
.rs-icon {
  font-size: 28rpx;
}

/* 区块内卡片容器 */
.rform-card {
  background: #f9fafb;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
}
.rform-card .rform-field + .rform-field {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #eef2ff;
}

/* 字段 */
.rform-field {
  display: block;
  width: 100%;
  box-sizing: border-box;
}
.rf-label {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 26rpx;
  color: #4b5563;
  font-weight: 500;
  margin-bottom: 10rpx;
}
.rf-req {
  color: #ef4444;
  font-weight: 700;
  margin-left: 2rpx;
}
.rf-opt {
  font-size: 20rpx;
  color: #9ca3af;
  background: #f3f4f6;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  font-weight: 400;
  margin-left: 6rpx;
}

/* 表格行式布局：label 左侧固定宽，输入右侧填充 */
.rform-field.rf-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.rform-field.rf-row .rf-label {
  width: 130rpx;
  flex-shrink: 0;
  margin-bottom: 0;
  font-size: 26rpx;
}
.rform-field.rf-row .rf-input,
.rform-field.rf-row .rf-picker {
  flex: 1;
  min-width: 0;
}

/* 输入框 */
.rf-input {
  display: block;
  width: 100%;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  background: #fff;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  box-sizing: border-box;
  color: #111827;
  transition: border-color 0.15s ease, background 0.15s ease;
  min-height: 72rpx;
}
.rf-input:focus {
  border-color: #6366f1;
  background: #fff;
}
.rf-ph {
  color: #9ca3af;
  font-size: 26rpx;
}

/* 文本域 */
.rf-textarea {
  width: 100%;
  height: 140rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  background: #fff;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  box-sizing: border-box;
  color: #111827;
}

/* 提示：台位由门店指派 */
.rform-tip {
  margin-top: 18rpx;
  padding: 18rpx 24rpx;
  font-size: 24rpx;
  color: #6366f1;
  background: linear-gradient(135deg, #eef2ff, #e0e7ff);
  border: 1rpx solid #c7d2fe;
  border-radius: 12rpx;
  text-align: center;
}

/* 选择器卡片 */
.rf-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  background: #fff;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  color: #111827;
  box-sizing: border-box;
}
.rf-arrow {
  font-size: 24rpx;
  color: #9ca3af;
}

/* 人数步进器 */
.stepper {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.step-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 14rpx;
  background: #fff;
  border: 2rpx solid #e5e7eb;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #6366f1;
  font-weight: 600;
  transition: transform 0.12s ease, background 0.12s ease;
}
.step-btn:active {
  transform: scale(0.92);
  background: #eef2ff;
}
.step-btn.step-disabled {
  color: #d1d5db;
  background: #f9fafb;
  pointer-events: none;
}
.step-val {
  min-width: 80rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
}
.step-unit {
  font-size: 24rpx;
  color: #6b7280;
  margin-left: 4rpx;
}

/* 桌台指派行 */
.assign-row {
  display: flex;
  gap: 14rpx;
  align-items: stretch;
}
.assign-row picker {
  flex: 1;
  min-width: 0;
}
.assign-row .rf-picker {
  height: 100%;
}

/* 智能推荐按钮 */
.rec-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 0 22rpx;
  background: linear-gradient(135deg, #6366f1, #818cf8);
  color: #fff;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 500;
  white-space: nowrap;
  box-shadow: 0 4rpx 10rpx rgba(99, 102, 241, 0.25);
  transition: transform 0.12s ease;
}
.rec-btn:active { transform: scale(0.95); opacity: 0.92; }
.rec-icon { font-size: 22rpx; }

/* 推荐提示 */
.hint {
  font-size: 22rpx;
  margin-top: 12rpx;
  padding: 10rpx 14rpx;
  border-radius: 10rpx;
  background: #f3f4f6;
  color: #6b7280;
  line-height: 1.5;
  min-height: 30rpx;
}
.hint.warn { color: #92400e; background: #fef3c7; }
.hint.err  { color: #991b1b; background: #fee2e2; }
.hint.ok   { color: #065f46; background: #d1fae5; }
