/* pages/user/records/records.wxss — 消费记录优化 */

.rec-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
/* 结算单卡片 */
.rec-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #f3f4f6;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: box-shadow 0.2s ease;
}
.rec-item:active { box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.05); }

.rec-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f3f4f6;
}
.rec-time {
  font-size: 26rpx;
  color: #374151;
  font-weight: 500;
}
/* 金额突出 */
.rec-total {
  font-size: 36rpx;
  font-weight: 700;
  color: #ef4444;
  line-height: 1.2;
}
.rec-meta {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 6rpx;
  line-height: 1.5;
}
.rec-meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 6rpx;
}
