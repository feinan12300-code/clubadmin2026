/* pages/user/billing/billing.wxss — 结算页面 */

.container { padding: 24rpx; box-sizing: border-box; }

/* 消费明细列表 */
.bill-list { padding: 4rpx 0; }
.bill-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
  gap: 12rpx;
}
.bill-name {
  flex: 1;
  font-size: 28rpx;
  color: #111827;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.bill-qty {
  font-size: 24rpx;
  color: #6b7280;
  min-width: 60rpx;
  text-align: center;
}
.bill-sub {
  font-size: 28rpx;
  color: #ef4444;
  font-weight: 600;
  min-width: 120rpx;
  text-align: right;
}

/* 合计 */
.bill-summary {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 20rpx 0 4rpx;
  border-top: 2rpx solid #f3f4f6;
  margin-top: 8rpx;
}
.bs-label {
  font-size: 28rpx;
  color: #6b7280;
}
.bs-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #ef4444;
}

/* 结算选项 */
.form-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
  gap: 16rpx;
}
.form-row label {
  font-size: 26rpx;
  color: #6b7280;
  width: 140rpx;
  flex: 0 0 140rpx;
}
.form-row input {
  flex: 1;
  font-size: 28rpx;
  color: #111827;
  padding: 12rpx 16rpx;
  background: #f9fafb;
  border-radius: 12rpx;
  border: 1rpx solid #e5e7eb;
}
.form-row .picker {
  flex: 1;
  font-size: 28rpx;
  color: #111827;
  padding: 12rpx 16rpx;
  background: #f9fafb;
  border-radius: 12rpx;
  border: 1rpx solid #e5e7eb;
}

/* 应付金额 */
.bill-pay {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 24rpx 0 20rpx;
  margin-top: 8rpx;
  border-top: 2rpx solid #f3f4f6;
}
.pay-label {
  font-size: 28rpx;
  color: #6b7280;
}
.pay-amount {
  font-size: 48rpx;
  font-weight: 700;
  color: #ef4444;
}

/* 全宽按钮 */
.btn-block {
  width: 100%;
  margin-top: 16rpx;
}
