/* pages/user/billing/billing.wxss — 结算页面 */

.container { padding: 24rpx; box-sizing: border-box; }

/* 消费明细列表 */
.bill-list { padding: 4rpx 0; }
.bill-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
  gap: 12rpx;
}
.bill-name {
  flex: 1;
  font-size: 28rpx;
  color: #111827;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.bill-qty {
  font-size: 24rpx;
  color: #6b7280;
  min-width: 60rpx;
  text-align: center;
}
.bill-sub {
  font-size: 28rpx;
  color: #ef4444;
  font-weight: 600;
  min-width: 120rpx;
  text-align: right;
}

/* 合计 */
.bill-summary {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 20rpx 0 4rpx;
  border-top: 2rpx solid #f3f4f6;
  margin-top: 8rpx;
}
.bs-label {
  font-size: 28rpx;
  color: #6b7280;
}
.bs-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #ef4444;
}

/* 支付方式选择 */
.pay-methods {
  display: flex;
  gap: 20rpx;
  padding: 16rpx 0;
}
.pay-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 12rpx;
  border: 3rpx solid #e5e7eb;
  border-radius: 16rpx;
  background: #fff;
  transition: all 0.2s ease;
}
.pay-option.active {
  border-color: #6366f1;
  background: linear-gradient(135deg, #eef2ff, #fff);
  box-shadow: 0 4rpx 14rpx rgba(99, 102, 241, 0.15);
}
.pay-option:active { transform: scale(0.97); }
.po-icon {
  font-size: 48rpx;
  margin-bottom: 10rpx;
}
.po-name {
  font-size: 24rpx;
  color: #374151;
  font-weight: 500;
}
.pay-option.active .po-name {
  color: #6366f1;
  font-weight: 700;
}

/* 应付金额 */
.bill-pay {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 24rpx 0 20rpx;
  margin-top: 8rpx;
  border-top: 2rpx solid #f3f4f6;
}
.pay-label {
  font-size: 28rpx;
  color: #6b7280;
}
.pay-amount {
  font-size: 48rpx;
  font-weight: 700;
  color: #ef4444;
}

/* 全宽按钮 */
.btn-block {
  width: 100%;
  margin-top: 16rpx;
}
