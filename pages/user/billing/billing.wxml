<venue-subnav venue-id="{{venueId}}" venue-name="{{venueName}}" active="billing"></venue-subnav>

<scroll-view scroll-y class="container">
  <!-- 无订单空状态 -->
  <view wx:if="{{allItems.length === 0}}" class="card">
    <view class="empty">
      <view class="empty-icon">🧾</view>
      <view>暂无消费</view>
      <view class="empty-tip">请先前往「点单」加菜后结算</view>
      <button class="btn btn-primary btn-sm" bindtap="goOrdering">去点单</button>
    </view>
  </view>

  <!-- 消费明细 -->
  <view wx:if="{{allItems.length > 0}}" class="card">
    <view class="card-title">
      <text>{{tableName}} 消费明细</text>
    </view>
    <view class="bill-list">
      <view wx:for="{{allItems}}" wx:key="idx" class="bill-row">
        <text class="bill-name">{{item.name}}</text>
        <text class="bill-qty">×{{item.qty}}</text>
        <text class="bill-sub">¥{{item.subStr}}</text>
      </view>
    </view>
    <view class="bill-summary">
      <text class="bs-label">合计</text>
      <text class="bs-num">¥{{totalStr}}</text>
    </view>
  </view>

  <!-- 结算选项 -->
  <view wx:if="{{allItems.length > 0}}" class="card">
    <view class="card-title"><text>结算选项</text></view>
    <view class="form-row">
      <label>折扣金额</label>
      <input type="digit" value="{{discount}}" bindinput="onDiscount" placeholder="0.00" />
    </view>
    <view class="form-row">
      <label>抹零</label>
      <picker bindchange="onRound" value="{{roundIndex}}" range="{{roundNames}}">
        <view class="picker">{{roundNames[roundIndex]}}</view>
      </picker>
    </view>
    <view class="form-row">
      <label>支付方式</label>
      <picker bindchange="onMethod" value="{{methodIndex}}" range="{{methodNames}}">
        <view class="picker">{{methodNames[methodIndex]}}</view>
      </picker>
    </view>
    <view class="bill-pay">
      <view class="pay-label">应付</view>
      <view class="pay-amount">¥{{payTotalStr}}</view>
    </view>
    <button class="btn btn-primary btn-block" bindtap="confirmSettle">确认结算</button>
  </view>
</scroll-view>
