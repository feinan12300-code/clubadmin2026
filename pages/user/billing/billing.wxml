<venue-subnav venue-id="{{venueId}}" venue-name="{{venueName}}" active="billing"></venue-subnav>

<scroll-view scroll-y class="container">
  <!-- 无订单空状态 -->
  <view wx:if="{{allItems.length === 0}}" class="card">
    <view class="empty">
      <view class="empty-icon">🧾</view>
      <view>暂无消费</view>
      <view class="empty-tip">请先前往「点单」加菜后结算</view>
      <button class="btn btn-primary btn-sm" bindtap="goOrdering">去点单</button>
    </view>
  </view>

  <!-- 消费明细 -->
  <view wx:if="{{allItems.length > 0}}" class="card">
    <view class="card-title">
      <text>{{tableName}} 消费明细</text>
    </view>
    <view class="bill-list">
      <view wx:for="{{allItems}}" wx:key="idx" class="bill-row">
        <text class="bill-name">{{item.name}}</text>
        <text class="bill-qty">×{{item.qty}}</text>
        <text class="bill-sub">¥{{item.subStr}}</text>
      </view>
    </view>
    <view class="bill-summary">
      <text class="bs-label">合计</text>
      <text class="bs-num">¥{{totalStr}}</text>
    </view>
  </view>

  <!-- 支付方式 -->
  <view wx:if="{{allItems.length > 0}}" class="card">
    <view class="card-title"><text>选择支付方式</text></view>
    <view class="pay-methods">
      <view class="pay-option {{methodIndex === 0 ? 'active' : ''}}" bindtap="selectMethod" data-idx="0">
        <view class="po-icon po-wechat">💚</view>
        <text class="po-name">微信支付</text>
      </view>
      <view class="pay-option {{methodIndex === 1 ? 'active' : ''}}" bindtap="selectMethod" data-idx="1">
        <view class="po-icon po-alipay">💙</view>
        <text class="po-name">支付宝</text>
      </view>
      <view class="pay-option {{methodIndex === 2 ? 'active' : ''}}" bindtap="selectMethod" data-idx="2">
        <view class="po-icon po-cash">💵</view>
        <text class="po-name">现金</text>
      </view>
    </view>
    <view class="bill-pay">
      <view class="pay-label">应付</view>
      <view class="pay-amount">¥{{totalStr}}</view>
    </view>
    <button class="btn btn-primary btn-block" bindtap="confirmSettle" loading="{{paying}}">确认支付</button>
  </view>
</scroll-view>
