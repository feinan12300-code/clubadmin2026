/* pages/user/venue-seats/venue-seats.wxss — 只读座位图：卡片网格 */

.container { padding: 24rpx; box-sizing: border-box; }

/* 顶部门店 banner：渐变 + 统计 */
.venue-banner {
  background: linear-gradient(135deg, #6366f1, #818cf8);
  color: #fff;
  border-radius: 24rpx;
  padding: 32rpx 28rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 18rpx rgba(99, 102, 241, 0.25);
  position: relative;
  overflow: hidden;
}
.venue-banner::after {
  content: '';
  position: absolute;
  right: -40rpx;
  top: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}
.vb-name {
  font-size: 38rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
  position: relative;
  line-height: 1.2;
}
.vb-sub {
  font-size: 24rpx;
  opacity: 0.9;
  margin-bottom: 22rpx;
  position: relative;
}
.vb-stats {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  position: relative;
}
.vs-item {
  flex: 1;
  text-align: center;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 14rpx;
  padding: 14rpx 6rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}
.vs-idle { background: rgba(16, 185, 129, 0.28); border-color: rgba(16, 185, 129, 0.4); }
.vs-occupied { background: rgba(239, 68, 68, 0.28); border-color: rgba(239, 68, 68, 0.4); }
.vs-reserved { background: rgba(245, 158, 11, 0.28); border-color: rgba(245, 158, 11, 0.4); }
.vs-num { font-size: 34rpx; font-weight: 700; line-height: 1.2; }
.vs-label { font-size: 22rpx; opacity: 0.9; margin-top: 4rpx; }

/* 图例 */
.legend {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx 24rpx;
  padding: 8rpx 4rpx 20rpx;
}
.lg {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: #6b7280;
}
.lg .dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #9ca3af;
}
.lg-idle .dot { background: #10b981; }
.lg-occupied .dot { background: #ef4444; }
.lg-reserved .dot { background: #f59e0b; }
.lg-bound .dot { background: #6366f1; }

/* 桌台网格：2 列 */
.table-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}
.table-card {
  position: relative;
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx 22rpx 22rpx;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.05);
  border: 2rpx solid #e5e7eb;
  box-sizing: border-box;
  transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
}
/* 状态色：左侧色条 */
.table-card.st-idle { border-color: #a7f3d0; }
.table-card.st-occupied { border-color: #fecaca; }
.table-card.st-reserved { border-color: #fde68a; }
.table-card.is-bound {
  border-color: #6366f1;
  box-shadow: 0 6rpx 20rpx rgba(99, 102, 241, 0.28);
  background: linear-gradient(135deg, #eef2ff, #fff);
}
.bound-flag {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  background: linear-gradient(135deg, #6366f1, #818cf8);
  color: #fff;
  font-size: 20rpx;
  font-weight: 500;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  box-shadow: 0 2rpx 6rpx rgba(99, 102, 241, 0.3);
}
.tc-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 12rpx;
  line-height: 1.3;
  padding-right: 60rpx;
  box-sizing: border-box;
}
.tc-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  margin-bottom: 14rpx;
}
.tc-type {
  color: #6366f1;
  background: #eef2ff;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.tc-cap {
  color: #6b7280;
  background: #f3f4f6;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.tc-status {
  display: inline-block;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-weight: 500;
}
.status-idle { background: #d1fae5; color: #065f46; }
.status-occupied { background: #fee2e2; color: #991b1b; }
.status-reserved { background: #fef3c7; color: #92400e; }

/* 空状态 */
.empty {
  text-align: center;
  padding: 100rpx 24rpx;
  color: #9ca3af;
}
.empty-icon { font-size: 80rpx; margin-bottom: 20rpx; opacity: 0.85; }
.empty-title { font-size: 32rpx; font-weight: 600; color: #1f2937; margin-bottom: 8rpx; }
.empty-tip { font-size: 26rpx; color: #9ca3af; }
