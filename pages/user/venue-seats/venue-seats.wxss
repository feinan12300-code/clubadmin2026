.container { padding: 24rpx; box-sizing: border-box; }

/* 顶部桌台横幅 */
.bound-banner {
  background: linear-gradient(135deg, #4f46e5, #6366f1);
  color: #fff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 18rpx rgba(99, 102, 241, 0.25);
}
.bb-label {
  font-size: 24rpx;
  opacity: 0.9;
  margin-bottom: 8rpx;
}
.bb-name {
  font-size: 48rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
}
.bb-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
}
.bb-type, .bb-cap { color: #fff; opacity: 0.9; }
.bb-meta .tag {
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
}

/* 信息行 */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
  font-size: 28rpx;
}
.info-row:last-child { border-bottom: none; }
.info-label { color: #6b7280; font-size: 26rpx; }
.info-value { color: #111827; font-weight: 500; }

/* 订单卡片 */
.order-card .order-hint {
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 20rpx;
  line-height: 1.5;
}
.btn-row {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 100rpx 40rpx;
  color: #9ca3af;
}
.empty-icon { font-size: 96rpx; margin-bottom: 24rpx; }
.empty-title { font-size: 34rpx; font-weight: 600; color: #1f2937; margin-bottom: 12rpx; }
.empty-desc { font-size: 26rpx; color: #9ca3af; margin-bottom: 32rpx; }
