/* pages/user/venue-seats/venue-seats.wxss — 绑定桌台展示优化 */

.container { padding: 24rpx; box-sizing: border-box; }

/* 顶部桌台横幅：渐变背景大卡片 */
.bound-banner {
  background: linear-gradient(135deg, #6366f1, #818cf8);
  color: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 18rpx rgba(99, 102, 241, 0.25);
  position: relative;
  overflow: hidden;
}
.bound-banner::after {
  content: '';
  position: absolute;
  right: -40rpx;
  top: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}
.bb-label {
  font-size: 24rpx;
  opacity: 0.9;
  margin-bottom: 10rpx;
  position: relative;
}
/* 桌台号大字显示 */
.bb-name {
  font-size: 56rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
  line-height: 1.2;
  position: relative;
  letter-spacing: 1rpx;
}
.bb-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  flex-wrap: wrap;
  position: relative;
}
.bb-type, .bb-cap { color: #fff; opacity: 0.9; }
.bb-meta .tag {
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

/* 信息行 */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
  font-size: 28rpx;
}
.info-row:last-child { border-bottom: none; }
.info-label { color: #6b7280; font-size: 26rpx; }
.info-value { color: #111827; font-weight: 500; }

/* 订单卡片 */
.order-card .order-hint {
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 20rpx;
  line-height: 1.5;
}
/* 操作按钮组 */
.btn-row {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 100rpx 40rpx;
  color: #9ca3af;
}
.empty-icon { font-size: 80rpx; margin-bottom: 24rpx; opacity: 0.85; }
.empty-title { font-size: 32rpx; font-weight: 600; color: #1f2937; margin-bottom: 12rpx; }
.empty-desc { font-size: 26rpx; color: #9ca3af; margin-bottom: 32rpx; }
