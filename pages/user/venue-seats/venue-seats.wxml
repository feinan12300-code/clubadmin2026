<venue-subnav venue-id="{{venueId}}" venue-name="{{venueName}}" active="seats"></venue-subnav>

<view class="container">
  <!-- 顶部当前桌台号 -->
  <view wx:if="{{hasBinding && boundTable}}" class="bound-banner">
    <view class="bb-label">当前桌位</view>
    <view class="bb-name">{{boundTable.name}}</view>
    <view class="bb-meta">
      <text class="bb-type">{{boundTable.typeLabel}}</text>
      <text class="bb-cap">· {{boundTable.capacity}}人</text>
      <text class="tag tag-{{boundTable.status}}">{{boundTable.statusLabel}}</text>
    </view>
  </view>

  <!-- 桌台详情卡片 -->
  <view wx:if="{{hasBinding && boundTable}}" class="card">
    <view class="card-title">
      <text>桌位信息</text>
      <text class="sub">{{boundTable.name}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">桌型</text>
      <text class="info-value">{{boundTable.typeLabel}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">容量</text>
      <text class="info-value">{{boundTable.capacity}} 人</text>
    </view>
    <view class="info-row">
      <text class="info-label">状态</text>
      <text class="info-value"><text class="tag tag-{{boundTable.status}}">{{boundTable.statusLabel}}</text></text>
    </view>
    <view class="info-row" wx:if="{{activeOrder}}">
      <text class="info-label">已点</text>
      <text class="info-value">{{activeOrder.itemCount}} 件 · ¥{{activeOrder.totalStr}}</text>
    </view>
  </view>

  <!-- 进行中订单提示 -->
  <view wx:if="{{hasBinding && activeOrder}}" class="card order-card">
    <view class="card-title"><text>进行中的订单</text></view>
    <view class="order-hint">您有未结算的订单，可前往点单继续加菜或去结算。</view>
    <view class="btn-row">
      <button class="btn btn-primary btn-block" bindtap="goOrdering">去点单</button>
      <button class="btn btn-success btn-block" bindtap="goBilling">去结算</button>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view wx:if="{{hasBinding && !activeOrder}}" class="card">
    <view class="card-title"><text>开始消费</text></view>
    <view class="order-hint">当前桌台为空闲状态，可前往点单开始本次消费。</view>
    <button class="btn btn-primary btn-block" bindtap="goOrdering">去点单</button>
  </view>

  <view wx:if="{{hasBinding}}" class="card">
    <button class="btn btn-block" bindtap="switchTable">切换其他桌位</button>
  </view>

  <!-- 未绑定桌台提示 -->
  <view wx:if="{{!hasBinding}}" class="empty">
    <view class="empty-icon">🪑</view>
    <view class="empty-title">请先选择桌位</view>
    <view class="empty-desc">您还未绑定本次就座的桌位</view>
    <button class="btn btn-primary" bindtap="goBind">去选择桌位</button>
  </view>
</view>
