<view class="container">
  <!-- 顶部门店信息 + 统计 -->
  <view class="venue-banner">
    <view class="vb-name">{{venueName}}</view>
    <view class="vb-sub">座位图（只读查看）</view>
    <view class="vb-stats">
      <view class="vs-item">
        <view class="vs-num">{{summary.total}}</view>
        <view class="vs-label">总桌数</view>
      </view>
      <view class="vs-item vs-idle">
        <view class="vs-num">{{summary.idle}}</view>
        <view class="vs-label">空闲</view>
      </view>
      <view class="vs-item vs-occupied">
        <view class="vs-num">{{summary.occupied}}</view>
        <view class="vs-label">占用</view>
      </view>
      <view class="vs-item vs-reserved">
        <view class="vs-num">{{summary.reserved}}</view>
        <view class="vs-label">预留</view>
      </view>
    </view>
  </view>

  <!-- 图例 -->
  <view class="legend">
    <view class="lg lg-idle"><view class="dot"></view>空闲</view>
    <view class="lg lg-occupied"><view class="dot"></view>占用</view>
    <view class="lg lg-reserved"><view class="dot"></view>预留</view>
    <view wx:if="{{hasBinding}}" class="lg lg-bound"><view class="dot"></view>我已绑定</view>
  </view>

  <!-- 桌台网格（只读） -->
  <view wx:if="{{tables.length === 0}}" class="empty">
    <view class="empty-icon">🪑</view>
    <view class="empty-title">该门店暂无桌台</view>
    <view class="empty-tip">请管理员在管理端添加桌台</view>
  </view>

  <view wx:else class="table-grid">
    <view
      wx:for="{{tables}}"
      wx:key="id"
      class="table-card st-{{item.status}} {{item.isBound ? 'is-bound' : ''}}"
    >
      <view wx:if="{{item.isBound}}" class="bound-flag">我的</view>
      <view class="tc-name">{{item.name}}</view>
      <view class="tc-meta">
        <text class="tc-type">{{item.typeLabel}}</text>
        <text class="tc-cap">{{item.capacity}}人</text>
      </view>
      <view class="tc-status status-{{item.status}}">{{item.statusLabel}}</view>
    </view>
  </view>
</view>
