.container { padding: 24rpx; box-sizing: border-box; }

/* 门店头部 */
.venue-head {
  background: linear-gradient(135deg, #4f46e5, #6366f1);
  color: #fff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 6rpx 18rpx rgba(99, 102, 241, 0.25);
}
.vh-name {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}
.vh-sub {
  font-size: 24rpx;
  opacity: 0.9;
}

/* 桌台网格 */
.table-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  padding-bottom: 140rpx;
}

.table-card {
  position: relative;
  background: #fff;
  border-radius: 18rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.05);
  border: 2rpx solid transparent;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.table-card:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 8rpx rgba(99, 102, 241, 0.25);
}
.table-card.bound {
  border-color: #6366f1;
  background: #eef2ff;
}

.tc-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 12rpx;
}
.tc-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
}
.tc-type { color: #6366f1; font-weight: 500; }
.tc-cap { color: #6b7280; }
.tc-tag {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #d1fae5;
  color: #065f46;
}

/* 底部提示 */
.bottom-tip {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 22rpx 24rpx;
  background: #fff;
  text-align: center;
  font-size: 26rpx;
  color: #6366f1;
  font-weight: 500;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.04);
  z-index: 20;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 80rpx 20rpx;
  color: #9ca3af;
}
.empty-icon { font-size: 80rpx; margin-bottom: 16rpx; }
.empty-tip { font-size: 24rpx; color: #9ca3af; margin-top: 8rpx; }
