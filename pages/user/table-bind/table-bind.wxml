<view class="container">
  <view class="venue-head">
    <view class="vh-name">{{venueName}}</view>
    <view class="vh-sub">台位由门店指派</view>
  </view>

  <!-- 已有 binding：显示已指派台位并可直接去点单 -->
  <view wx:if="{{hasBinding}}" class="bind-banner">
    <view class="bb-icon">🎟️</view>
    <view class="bb-info">
      <view class="bb-title">已指派台位：{{boundTableName}}</view>
      <view class="bb-sub">由门店工作人员为您分配</view>
    </view>
    <view class="bb-actions">
      <view class="bb-btn bb-btn-primary" bindtap="goOrdering">去点单</view>
    </view>
  </view>

  <!-- 无 binding：提示去预定 -->
  <view wx:else class="empty">
    <view class="empty-icon">📭</view>
    <view class="empty-title">尚未获得台位指派</view>
    <view class="empty-tip">请先创建预定，待门店确认并指派台位后即可进入</view>
    <view class="bb-btn bb-btn-primary" bindtap="goReservation">去预定</view>
  </view>
</view>
