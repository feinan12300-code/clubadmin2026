/* pages/index/index.wxss — 首页：黑色夜空流星雨 */

.index-wrap {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
  background: radial-gradient(ellipse at top, #0a0a2e 0%, #000000 70%);
  position: relative;
  overflow: hidden;
}

/* ============ 夜空背景：星 + 流星 ============ */
.night-sky {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
}

/* 闪烁小星点 */
.star {
  position: absolute;
  background: #fff;
  border-radius: 50%;
  box-shadow: 0 0 6rpx rgba(255, 255, 255, 0.8);
  animation: twinkle 3s ease-in-out infinite;
}
@keyframes twinkle {
  0%, 100% { opacity: 0.2; transform: scale(0.8); }
  50%      { opacity: 1;   transform: scale(1.3); }
}

/* 流星：斜向划过的光线 */
.meteor {
  position: absolute;
  width: 2rpx;
  height: 2rpx;
  background: transparent;
  animation: meteor linear infinite;
}
.meteor-tail {
  position: absolute;
  top: 0;
  left: 0;
  width: 2rpx;
  height: 100rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.9), rgba(129, 140, 248, 0.4), transparent);
  border-radius: 999rpx;
}
@keyframes meteor {
  0% {
    transform: translate(0, 0) rotate(135deg);
    opacity: 0;
  }
  10% {
    opacity: 1;
  }
  100% {
    transform: translate(800rpx, 800rpx) rotate(135deg);
    opacity: 0;
  }
}

/* 背景装饰光晕（与夜空融合） */
.index-wrap::before {
  content: '';
  position: absolute;
  top: -120rpx;
  right: -120rpx;
  width: 400rpx;
  height: 400rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(129, 140, 248, 0.18) 0%, transparent 70%);
  pointer-events: none;
  z-index: 0;
}
.index-wrap::after {
  content: '';
  position: absolute;
  bottom: -160rpx;
  left: -160rpx;
  width: 460rpx;
  height: 460rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(99, 102, 241, 0.15) 0%, transparent 70%);
  pointer-events: none;
  z-index: 0;
}

/* ============ 前景内容（logo / 标题 / 按钮） ============ */
.logo {
  font-size: 140rpx;
  margin-bottom: 30rpx;
  user-select: none;
  position: relative;
  z-index: 2;
  filter: drop-shadow(0 6rpx 16rpx rgba(0, 0, 0, 0.6));
  animation: logo-float 3s ease-in-out infinite;
}
@keyframes logo-float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8rpx); }
}

.title {
  font-size: 52rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
  position: relative;
  z-index: 2;
  text-shadow: 0 4rpx 16rpx rgba(129, 140, 248, 0.6);
  text-align: center;
}
.subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 80rpx;
  position: relative;
  z-index: 2;
}

/* 圆形按钮：与夜空主题融合 */
.login-btn {
  width: 180rpx;
  height: 180rpx;
  line-height: 180rpx;
  padding: 0;
  background: linear-gradient(135deg, #6366f1, #818cf8);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 50%;
  border: none;
  box-shadow: 0 0 30rpx rgba(129, 140, 248, 0.6), 0 8rpx 24rpx rgba(99, 102, 241, 0.45);
  position: relative;
  z-index: 2;
  transition: transform 0.15s ease, opacity 0.15s ease;
  text-align: center;
}
.login-btn:active {
  transform: scale(0.95);
  opacity: 0.92;
}
.login-btn[disabled] {
  background: linear-gradient(135deg, rgba(99, 102, 241, 0.5), rgba(129, 140, 248, 0.5));
  color: rgba(255, 255, 255, 0.85);
  box-shadow: none;
}
