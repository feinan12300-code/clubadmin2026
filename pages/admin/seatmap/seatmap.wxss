.container { padding: 24rpx; box-sizing: border-box; }
.legend {
  display: flex;
  gap: 24rpx;
  padding: 12rpx 24rpx 20rpx;
  font-size: 24rpx;
  color: #6b7280;
}
.legend-item { display: flex; align-items: center; gap: 8rpx; }
.dot { width: 16rpx; height: 16rpx; border-radius: 50%; display: inline-block; }

/* 工具栏卡片：圆角 24rpx、柔和阴影 */
.toolbar {
  background: #fff;
  border-radius: 24rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid #f3f4f6;
}
.tool-group { margin-bottom: 12rpx; }
.tool-group:last-child { margin-bottom: 0; }
.tool-label { font-size: 22rpx; color: #9ca3af; margin-bottom: 8rpx; }
.tool-btns { display: flex; flex-wrap: wrap; gap: 12rpx; }
.tool-btn {
  padding: 10rpx 20rpx;
  background: #f3f4f6;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #374151;
  transition: opacity 0.15s ease, transform 0.12s ease;
}
.tool-btn:active { opacity: 0.85; transform: scale(0.97); }
.tool-btn.active {
  background: linear-gradient(135deg, #6366f1, #818cf8);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(99, 102, 241, 0.28);
}
.tool-btn.danger { background: #fee2e2; color: #ef4444; }
.tool-btn.primary {
  background: linear-gradient(135deg, #6366f1, #818cf8);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(99, 102, 241, 0.28);
}

/* 画布容器：圆角 24rpx、柔和阴影 */
/* position + z-index 确保 modal（z-index:1000）显示在 canvas 之上，避免原生 canvas 层级穿透 */
.canvas-wrap {
  position: relative;
  z-index: 1;
  background: #fff;
  border-radius: 24rpx;
  padding: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid #f3f4f6;
  height: 900rpx;
}
.seat-canvas { width: 100%; height: 100%; }
