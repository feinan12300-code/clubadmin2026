.container { padding: 24rpx; box-sizing: border-box; }

.empty {
  text-align: center;
  padding: 120rpx 24rpx;
  color: #9ca3af;
}
.empty-icon { font-size: 80rpx; margin-bottom: 20rpx; opacity: 0.85; }
.empty-tip { font-size: 24rpx; margin-top: 8rpx; }

/* 通知卡片 */
.notice-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.05);
  border-left: 6rpx solid #6366f1;
}
.notice-card.status-pending { border-left-color: #f59e0b; }
.notice-card.status-review  { border-left-color: #3b82f6; }
.notice-card.status-handled { border-left-color: #10b981; opacity: 0.7; }

.nc-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.nc-customer {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}
.nc-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
}
.nc-party {
  font-size: 24rpx;
  color: #6b7280;
  background: #f3f4f6;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}
.nc-status {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 500;
}
.nc-status-pending { background: #fef3c7; color: #92400e; }
.nc-status-review  { background: #dbeafe; color: #1e40af; }
.nc-status-handled { background: #d1fae5; color: #065f46; }

.nc-detail {
  background: #f9fafb;
  border-radius: 12rpx;
  padding: 16rpx 18rpx;
}
.nc-row {
  display: flex;
  align-items: flex-start;
  font-size: 26rpx;
  margin-bottom: 10rpx;
}
.nc-row:last-child { margin-bottom: 0; }
.nc-key {
  color: #6b7280;
  width: 140rpx;
  flex-shrink: 0;
}
.nc-val {
  color: #111827;
  flex: 1;
  word-break: break-all;
}
.nc-tbl {
  color: #6366f1;
  font-weight: 600;
}
.nc-unset {
  color: #ef4444;
  font-size: 22rpx;
  background: #fee2e2;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}
.nc-meta-row {
  margin-top: 8rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid #e5e7eb;
  font-size: 22rpx;
  justify-content: space-between;
}
.nc-meta-row .nc-key { width: auto; flex: 1; }
.nc-time { color: #9ca3af; }

.nc-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}
.nc-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
}
.nc-btn-primary {
  background: linear-gradient(135deg, #6366f1, #818cf8);
  color: #fff;
  box-shadow: 0 4rpx 10rpx rgba(99, 102, 241, 0.25);
}
.nc-btn-ghost {
  background: #fff;
  color: #10b981;
  border: 2rpx solid #d1fae5;
}
.nc-btn:active { transform: scale(0.97); }

/* 指派弹窗 */
.assign-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.assign-box {
  width: 86%;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
}
.assign-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 20rpx;
  text-align: center;
}
.assign-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  background: #f9fafb;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  color: #111827;
}
.assign-arrow { color: #9ca3af; font-size: 24rpx; }
.assign-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}
.assign-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
}
.assign-cancel { background: #f3f4f6; color: #4b5563; }
.assign-confirm {
  background: linear-gradient(135deg, #6366f1, #818cf8);
  color: #fff;
  box-shadow: 0 4rpx 10rpx rgba(99, 102, 241, 0.25);
}
.assign-btn:active { transform: scale(0.97); }
