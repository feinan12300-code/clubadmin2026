.venue-bar {
  background: #fff;
  padding: 18rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border-bottom: 1rpx solid #e5e7eb;
  flex-shrink: 0;
}
.venue-bar .label { font-size: 24rpx; color: #6b7280; white-space: nowrap; }
.venue-bar picker { flex: 1; }
.venue-bar .picker-box {
  background: #f3f4f6;
  padding: 14rpx 20rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #111827;
}
